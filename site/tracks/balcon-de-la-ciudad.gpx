  <metadata><name>Balcón de la Ciudad</name><desc>Ida y vuelta · Sierra Colorada, Capital. Inicio: Quebrada baja de El Tala, Bº San Francisco, RP 4 km 17. 4,86 km, +580 m, altura máxima 1.788 m. IBP 79 (senderismo). Señales revisadas el 16/11/2026. Dirección Provincial de Rendimiento Deportivo, Catamarca. Noviembre de 2026.</desc></metadata>
  <wpt lat="-28.362090" lon="-65.873467"><ele>1203</ele><name>Inicio · RP 4 km 17</name><desc>Panel con mapa, perfil, IBP y cómo resulta según la preparación, tiempo de ida y de vuelta, y teléfonos. Aviso: cuesta fuerte y sin sombra.</desc><sym>Trailhead</sym><type>Panel de inicio</type></wpt>
  <wpt lat="-28.362112" lon="-65.873186"><ele>1202</ele><name>Paso del alambrado</name><desc>Cartel de alambrado. Propuesta aparte: poner un portón.</desc><sym>Gate</sym><type>Tranquera o alambrado</type></wpt>
  <wpt lat="-28.361958" lon="-65.873235"><ele>1202</ele><name>Comienzo del sendero y ruinas</name><desc>Flecha al Balcón de la Ciudad con km y altura. En el mismo soporte, el interpretativo de las ruinas.</desc><sym>Crossing</sym><type>Poste direccional</type></wpt>
  <wpt lat="-28.361679" lon="-65.873275"><ele>1208</ele><name>Ruinas arqueológicas</name><desc>Sitio arqueológico: no mover piedras. Va en el soporte del poste de comienzo.</desc><sym>Information</sym><type>Cartel interpretativo</type></wpt>
  <wpt lat="-28.361391" lon="-65.872972"><ele>1229</ele><name>Retome del sendero</name><desc>Giro marcado.</desc><sym>Flag, Blue</sym><type>Estaca de cambio de dirección</type></wpt>
  <wpt lat="-28.361346" lon="-65.871947"><ele>1279</ele><name>Cuesta</name><desc>Tramo largo sin marcas: confirma que se va bien.</desc><sym>Flag, Blue</sym><type>Estaca de continuidad</type></wpt>
  <wpt lat="-28.361781" lon="-65.871392"><ele>1325</ele><name>Tranquera rota</name><desc>Cartel de tranquera.</desc><sym>Gate</sym><type>Tranquera o alambrado</type></wpt>
  <wpt lat="-28.361754" lon="-65.870614"><ele>1379</ele><name>Cuesta</name><desc>Confirma que se va bien.</desc><sym>Flag, Blue</sym><type>Estaca de continuidad</type></wpt>
  <wpt lat="-28.361338" lon="-65.869914"><ele>1433</ele><name>Mirador norte</name><desc>Palo borracho y cardón.</desc><sym>Scenic Area</sym><type>Mirador</type></wpt>
  <wpt lat="-28.360781" lon="-65.868462"><ele>1517</ele><name>Cuesta</name><desc>Tramo de 600 m sin marcas: confirma que se va bien.</desc><sym>Flag, Blue</sym><type>Estaca de continuidad</type></wpt>
  <wpt lat="-28.360634" lon="-65.867298"><ele>1610</ele><name>Gruta de la Virgen del Valle</name><desc>Mitad de la cuesta: altura y metros que faltan. Pedir que se termine la gruta: está a medio hacer.</desc><sym>Information</sym><type>Cartel interpretativo</type></wpt>
  <wpt lat="-28.360716" lon="-65.866933"><ele>1624</ele><name>Retome junto a la peña</name><desc>Giro junto a la peña.</desc><sym>Flag, Blue</sym><type>Estaca de cambio de dirección</type></wpt>
  <wpt lat="-28.360280" lon="-65.864910"><ele>1739</ele><name>Poste existente (fin de la cuesta)</name><desc>Ya existe: revisarlo y sumarle destino y km. Marca el fin de la cuesta.</desc><sym>Crossing</sym><type>Poste direccional</type></wpt>
  <wpt lat="-28.360300" lon="-65.864305"><ele>1759</ele><name>Terrazas y pircas</name><desc>Terrazas de cultivo antiguas: no mover piedras.</desc><sym>Information</sym><type>Cartel interpretativo</type></wpt>
  <wpt lat="-28.360774" lon="-65.863732"><ele>1776</ele><name>Desvío de las apachetas</name><desc>Tres flechas: al Balcón, a la cima de la Sierra Colorada por el filo (sin señalizar, solo con experiencia) y de regreso al inicio.</desc><sym>Crossing</sym><type>Poste direccional</type></wpt>
  <wpt lat="-28.360891" lon="-65.863579"><ele>1778</ele><name>Confirmación camino al Balcón</name><desc>A menos de 25 m del desvío, sobre el camino al Balcón.</desc><sym>Flag, Blue</sym><type>Estaca de continuidad</type></wpt>
  <wpt lat="-28.361915" lon="-65.862787"><ele>1781</ele><name>Segundo punto donde se pierde la gente</name><desc>Pintada de las dos caras, mirando también a la bajada. Lugar exacto a confirmar.</desc><sym>Flag, Blue</sym><type>Estaca de continuidad</type></wpt>
  <wpt lat="-28.362640" lon="-65.861845"><ele>1789</ele><name>Balcón de la Ciudad</name><desc>Nombre, altura y km recorridos. Flecha de regreso. Precaución: borde.</desc><sym>Summit</sym><type>Cartel de destino</type></wpt>
